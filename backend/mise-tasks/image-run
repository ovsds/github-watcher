#!/usr/bin/env bash
#MISE description="Run image in container"
#USAGE arg "<target>"
#USAGE flag "--hostname <hostname>"
#USAGE flag "--exposed-port <port>"
set -euo pipefail

args=()
if [ -n "${usage_hostname:-}" ]; then
  args+=(--hostname "${usage_hostname}")
fi
if [ -n "${usage_exposed_port:-}" ]; then
  args+=(--publish "${usage_exposed_port}:${usage_exposed_port}")
fi

echo "Running image ${usage_target} target..."
# bash 3.2 treats an empty array as unbound under set -u
docker run \
  ${args[@]+"${args[@]}"} \
  --env-file <(env | cut -f1 -d=) \
  --volume "${MISE_CONFIG_ROOT}/.settings:/opt/app/.settings" \
  --env GITHUB_WATCHER_SETTINGS_YAML="/opt/app/.settings/dev.yaml" \
  --env GITHUB_WATCHER_SETTINGS_TEST_YAML="/opt/app/.settings/test.yaml" \
  "github-watcher:${usage_target}"
